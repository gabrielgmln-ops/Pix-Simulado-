# Copie para .env e ajuste. O arquivo .env NUNCA deve ser versionado.
# Todos os valores abaixo são sintéticos.

# --- Banco de dados ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pix
DB_USER=pix
DB_PASSWORD=troque-esta-senha

# --- Ledger API (motor de saldo) ---
# Dentro do docker compose o padrão é http://host.docker.internal:8081
LEDGER_BASE_URL=http://localhost:8081
LEDGER_API_KEY=troque-esta-chave

# --- Instituição simulada ---
PIX_ISPB=99999999
PIX_NOME_INSTITUICAO=PIX SIMULADO SA
PIX_CIDADE=SAO PAULO

SERVER_PORT=8080
PIX_LIMITE_CHAVES_POR_CONTA=5
